#!/usr/bin/env -S sbcl --script
(require :sb-posix)
(require :uiop)
(defconstant +lid-name+ "eDP")
(defconstant +ext-name+ "HDMI-A-0")
(defun rerandr ()
  (let (
    (names (if
      (search
        (concatenate 'string +ext-name+ " connected")
        (uiop:run-program '("xrandr") :output :string))
      (list +ext-name+ +lid-name+)
      (list +lid-name+ +ext-name+))))
    (uiop:run-program `("xrandr" "--output" ,(car names) "--primary" "--auto"))
    (uiop:run-program `("xrandr" "--output" ,(cadr names) "--off"))))
(defparameter *force-rerandr* t)
(sb-sys:enable-interrupt sb-unix:sigusr1 (lambda (sig info context) (setf *force-rerandr* t)))
(with-open-file (f "/tmp/monman.pid" :direction :output :if-exists :supersede)
  (write (sb-posix:getpid) :stream f))
(loop
  (when *force-rerandr*
    (setf *force-rerandr* nil)
    (rerandr))
  (sleep 1))

