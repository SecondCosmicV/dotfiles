#!/usr/bin/env -S sbcl --script
;; KeyBoard Layout Manager
(require :uiop)
(defun get-curr-layout ()
  (cadr
    (remove
      ""
      (uiop:split-string (caddr
        (uiop:split-string
          (uiop:run-program '("setxkbmap" "-query") :output :string)
          :separator '(#\newline))))
      :test #'equal)))
(defconstant +layouts+ '("us" "hu"))
(defconstant +cmd+ (car (uiop:command-line-arguments)))
(cond
  ((equal +cmd+ "query")
    (princ (get-curr-layout))
    (terpri))
  ((equal +cmd+ "toggle")
    (uiop:run-program (list
      "setxkbmap"
      "-layout"
      (nth
        (mod
          (1+ (position (get-curr-layout) +layouts+ :test #'equal))
          (length +layouts+))
        +layouts+))))
  (t (uiop:quit 1)))

