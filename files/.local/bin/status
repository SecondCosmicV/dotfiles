#!/usr/bin/env -S sbcl --script
(require :sb-posix)
(require :asdf)
(require :cl-ppcre)
(require :local-time)
(defun human (n)
  (let (
    (u '(#\space #\K #\M #\G #\T #\P #\E))
    (nn -1))
    (loop while (>= n 1000) do
      (setf u (cdr u))
      (setf nn (truncate (/ n 100)))
      (setf n (truncate (/ n 1000))))
    (setf u (string-trim '(#\space) (string (car u))))
    (concatenate 'string
      (write-to-string n)
      (if (and (< n 10) (> nn -1))
        (concatenate 'string
          ","
          (write-to-string (mod nn 10)))
        "")
      u)))
(defclass time-module () (
  (display :accessor module-display)))
(defmethod module-update ((m time-module))
  (setf
    (module-display m)
    (local-time:format-timestring
      nil
      (local-time:now)
      :format '(
        :year
        #\-
        (:month 2)
        #\-
        (:day 2)
        #\space
        (:hour 2)
        #\:
        (:min 2)
        #\:
        (:sec 2)
        " (UTC"
        :gmt-offset #\)))))
(defclass keyboard-module () (
  (display :accessor module-display)))
(defmethod module-update ((m keyboard-module))
  (setf
    (module-display m)
    (string-right-trim
      '(#\newline)
      (uiop:run-program '("kblm" "query") :output :string))))
(defclass battery-module () (
  (display :accessor module-display)))
(defmethod module-update ((m battery-module))
  (let (
    (a (cl-ppcre:split
      ", "
      (cadr (cl-ppcre:split
        ": "
        (string-right-trim
          '(#\newline)
          (uiop:run-program '("acpi") :output :string)))))))
    (setf
      (module-display m)
      (concatenate 'string
        (subseq (cadr a) 0 (1- (length (cadr a))))
        (string (char-downcase (char (car a) 0)))))))
(defclass ram-module () (
  (display :accessor module-display)))
(defmethod module-update ((m ram-module))
  (setf
    (module-display m)
    (caddr (cl-ppcre:split
      "\\s+"
      (cadr (uiop:split-string
        (uiop:run-program '("free" "-h" "--si") :output :string)
        :separator '(#\newline)))))))
(defclass cpu-module () (
  (curr :initform '(0 0) :accessor cpu-module-curr)
  (display :accessor module-display)))
(defmethod module-update ((m cpu-module))
  (let (
    (prev (cpu-module-curr m))
    (fields (mapcar #'parse-integer (cdr (cl-ppcre:split
      "\\s+"
      (with-open-file (f "/proc/stat")
        (read-line f)))))))
    (setf
      (cpu-module-curr m)
      (list
        (cadddr fields)
        (apply #'+ fields)))
    (setf
      (module-display m)
      (write-to-string (floor (* -100 (1- (/
        (- (car (cpu-module-curr m)) (car prev))
        (- (cadr (cpu-module-curr m)) (cadr prev))))))))))
(defclass temperature-module () (
  (display :accessor module-display)))
(defmethod module-update ((m temperature-module))
  (let (
    (a (cadar
      (remove-if-not
        (lambda (x)
          (equal (car x) "CPU:"))
        (mapcar
          (lambda (x)
            (cl-ppcre:split "\\s+" x))
          (uiop:split-string
            (car
              (remove-if-not
                (lambda (x)
                  (uiop:string-prefix-p "thinkpad-isa-0000" x))
                (cl-ppcre:split
                  (coerce (make-list 2 :initial-element #\newline) 'string)
                  (uiop:run-program '("sensors") :output :string))))
            :separator '(#\newline)))))))
    (setf
      (module-display m)
      (write-to-string (floor (read-from-string
        (subseq a 0 (- (length a) 2))))))))
(defclass brightness-module () (
  (display :accessor module-display)))
(defmethod module-update ((m brightness-module))
  (let (
    (a (cadddr (uiop:split-string
      (string-left-trim
        '(#\tab)
        (cadr
          (uiop:split-string
            (uiop:run-program '("brightnessctl") :output :string)
            :separator '(#\newline))))))))
    (setf
      (module-display m)
      (subseq a 1 (- (length a) 2)))))
(defclass pulse-module () (
  (type :initarg :type :accessor pulse-module-type)
  (display :accessor module-display)))
(defmethod module-update ((m pulse-module))
  (let* (
    (outs (mapcar
      (lambda (x)
        (uiop:run-program (list
          "pactl"
          (format nil "get-~a-~a" (pulse-module-type m) x)
          (format nil "@DEFAULT_~a@" (string-upcase (pulse-module-type m))))
          :output :string))
      '("volume" "mute")))
    (vol (nth 4
      (cl-ppcre:split
        "\\s+"
        (car outs)))))
    (setf
      (module-display m)
      (concatenate 'string
        (subseq vol 0 (1- (length vol)))
        (if (search "nein" (cadr outs)) "u" "m")))))
(defclass disk-module () (
  (device :accessor disk-module-device)
  (bytes-per-sector :accessor disk-module-bytes-per-sector)
  (curr-sectors :initform '(0 0) :accessor disk-module-curr-sectors)
  (curr-upd-ts :initform 0 :accessor disk-module-curr-upd-ts)
  (display :accessor module-display)))
(defmethod initialize-instance :after ((m disk-module) &key)
  (setf
    (disk-module-device m)
    (string-right-trim
      '(#\newline)
      (uiop:run-program
        "lsblk -slno NAME $(df -h --output=source ~/stuff | tail -n 1) | tail -n 1"
        :output :string)))
  (setf
    (disk-module-bytes-per-sector m)
    (parse-integer
      (uiop:read-file-string
        (format nil "/sys/block/~a/queue/hw_sector_size" (disk-module-device m)))))
  (module-update m))
(defmethod module-update ((m disk-module))
  (let (
    (prev-sectors (disk-module-curr-sectors m))
    (prev-upd-ts (disk-module-curr-upd-ts m))
    (diskstats (car (remove-if-not
      (lambda (x)
        (equal (caddr x) (disk-module-device m)))
      (mapcar
        (lambda (x)
          (cl-ppcre:split "\\s+" (string-trim '(#\space) x)))
        (with-open-file (f "/proc/diskstats")
          (loop for x = (read-line f nil) while x collect x)))))))
    (setf (disk-module-curr-sectors m) (list
      (parse-integer (nth 5 diskstats))
      (parse-integer (nth 9 diskstats))))
    (setf (disk-module-curr-upd-ts m)
      (/ (get-internal-real-time) internal-time-units-per-second))
    (setf (module-display m)
      (apply #'format (concatenate 'list
        '(nil "v~d/s ^~d/s")
        (mapcar
          (lambda (x)
            (human (ceiling (/
              (*
                (disk-module-bytes-per-sector m)
                (- (nth x (disk-module-curr-sectors m)) (nth x prev-sectors)))
              (- (disk-module-curr-upd-ts m) prev-upd-ts)))))
          '(0 1)))))))
(defclass net-module () (
  (interf :accessor net-module-interf)
  (curr-bytes :initform '(0 0) :accessor net-module-curr-bytes)
  (curr-upd-ts :initform 0 :accessor net-module-curr-upd-ts)
  (display :accessor module-display)))
(defmethod initialize-instance :after ((m net-module) &key)
  (setf (net-module-interf m)
    (caar (remove-if-not
      (lambda (x)
        (equal (cadr x) "wifi"))
      (mapcar
        (lambda (x)
          (uiop:split-string x :separator '(#\:)))
        (uiop:split-string
          (uiop:run-program
            '("nmcli" "-t" "-f" "DEVICE,TYPE" "device")
            :output :string)
          :separator '(#\newline))))))
  (module-update m))
(defmethod module-update ((m net-module))
  (let (
    (prev-bytes (net-module-curr-bytes m))
    (prev-upd-ts (net-module-curr-upd-ts m)))
    (setf (net-module-curr-bytes m)
      (mapcar
        (lambda (x)
          (parse-integer
            (with-open-file (
              f
              (format
                nil
                "/sys/class/net/~a/statistics/~cx_bytes"
                (net-module-interf m)
                x))
              (read-line f))))
        '(#\r #\t)))
    (setf (net-module-curr-upd-ts m)
      (/ (get-internal-real-time) internal-time-units-per-second))
    (setf (module-display m)
      (apply #'format (concatenate 'list
        '(nil "v~d/s ^~d/s")
        (mapcar
          (lambda (x)
            (human (ceiling (/
              (- (nth x (net-module-curr-bytes m)) (nth x prev-bytes))
              (- (net-module-curr-upd-ts m) prev-upd-ts)))))
          '(0 1)))))))
(defparameter *module-list* `(
  (,(make-instance 'net-module) "net" 2)
  (,(make-instance 'disk-module) "disk" 2)
  (,(make-instance 'pulse-module :type "source") "srce" 10)
  (,(make-instance 'pulse-module :type "sink") "sink" 10)
  (,(make-instance 'brightness-module) "brig" 10)
  (,(make-instance 'temperature-module) "temp" 10)
  (,(make-instance 'cpu-module) "cpu" 2)
  (,(make-instance 'ram-module) "ram" 2)
  (,(make-instance 'battery-module) "bat" 10)
  (,(make-instance 'keyboard-module) "keyb" 10)
  (,(make-instance 'time-module) "earth" 1)))
(defun refresh (i)
  (dolist (x *module-list*)
    (when (zerop (mod i (caddr x)))
      (module-update (car x))))
  (princ
    (reduce
      (lambda (a b)
        (concatenate 'string a " | " b))
      (mapcar
        (lambda (x)
          (format nil "~a: ~a" (cadr x) (module-display (car x))))
        *module-list*)))
  (terpri)
  (finish-output))
(sb-sys:enable-interrupt sb-unix:sigusr1 (lambda (sig info context) (refresh 0)))
(with-open-file (f "/tmp/status.pid" :direction :output :if-exists :supersede)
  (write (sb-posix:getpid) :stream f))
(loop for i from 0 do
  (ignore-errors (refresh i))
  (sleep 1))

