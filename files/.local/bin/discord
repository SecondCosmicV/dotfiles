#!/usr/bin/env bash

exec guix time-machine \
    --channels=$HOME/.config/guix/channels.pinned.scm \
    -- \
    shell \
    --container \
    --emulate-fhs \
    --no-cwd \
    --network \
    --preserve="^DISPLAY$" \
    --expose=$XAUTHORITY \
    --share=/dev/shm \
    --share=$HOME/.config/discord \
    --manifest=$HOME/.local/share/manifests/discord.scm \
    -- \
    discord

